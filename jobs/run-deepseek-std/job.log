\n    if 'out' in d and 'in' in d:\n        o=d['out']['payload']; n=d['in']['payload']\n        if o['amount_minor']==n['amount_minor'] and o['account_id']==n['peer_account'] and n['account_id']==o['peer_account']:\n            complete.add(tid)\nprint('complete transfers',complete)\n\n# sort events by ts (opened_at for open, ts otherwise), shard, seq\nfor e in events:\n    p=e['payload']\n    e['ts']=p.get('ts', p.get('opened_at'))\nevents_sorted=sorted([e for e in events if e['ts'] is not None], key=lambda e:(e['ts'], e['shard_id'], e['seq']))\n\naccounts={}\nidem_seen=set()\nheld=defaultdict(list)\nsummary=defaultdict(lambda: defaultdict(int))\n\ndef day_for(ts):\n    return datetime.fromtimestamp(ts, tz=timezone.utc).astimezone(ny).strftime('%Y-%m-%d')\n\ndef add_delta(acct_id, delta, ts):\n    acct=accounts[acct_id]\n    acct['balance_minor'] += delta\n    summary[day_for(ts)][acct['currency']] += delta\n\ndef apply_balance_event(acct_id, delta, ts, idem_key=None):\n    if idem_key is not None:\n        if idem_key in idem_seen:\n            return\n        idem_seen.add(idem_key)\n    acct=accounts.get(acct_id)\n    if acct is None:\n        return\n    if acct['status']=='closed':\n        held[acct_id].append((delta, ts))\n    else:\n        add_delta(acct_id, delta, ts)\n\nfor e in events_sorted:\n    typ=e['type']; p=e['payload']; ts=e['ts']\n    if typ==1:\n        accounts[p['account_id']]={'account_id':p['account_id'],'currency':p['currency'],'balance_minor':0,'opened_at':p['opened_at'],'status':'open'}\n    elif typ==2:\n        apply_balance_event(p['account_id'], p['amount_minor'], ts, p.get('idempotency_key'))\n    elif typ==3:\n        apply_balance_event(p['account_id'], -p['amount_minor'], ts, p.get('idempotency_key'))\n    elif typ==4:\n        tid=p['transfer_id']\n        if tid in complete:\n            apply_balance_event(p['account_id'], -p['amount_minor'], ts)\n    elif typ==5:\n        tid=p['transfer_id']\n        if tid in complete:\n            apply_balance_event(p['account_id'], p['amount_minor'], ts)\n    elif typ==6:\n        acct=accounts.get(p['account_id'])\n        if acct: acct['status']='closed'\n    elif typ==7:\n        acct=accounts.get(p['account_id'])\n        if acct:\n            acct['status']='open'\n            for delta, hts in held.pop(p['account_id'], []):\n                add_delta(p['account_id'], delta, hts)\n    elif typ==8:\n        pass\n\nopen_accounts={k:v for k,v in accounts.items() if v['status']=='open'}\nprint('\\nOPEN ACCOUNTS')\nfor k in sorted(open_accounts):\n    v=open_accounts[k]\n    print(k, {kk:v[kk] for kk in ('account_id','currency','balance_minor','opened_at')})\nprint('\\nSUMMARY')\nfor d in sorted(summary):\n    print(d, dict(sorted(summary[d].items())))\nprint('\\nPENDING')\npending=[]\nfor tid in sorted(legs):\n    if tid in complete: continue\n    d=legs[tid]\n    out=d.get('out'); inn=d.get('in')\n    op=out['payload'] if out else None\n    ip=inn['payload'] if inn else None\n    pending.append({\n        'transfer_id':tid,\n        'has_out':out is not None,\n        'has_in':inn is not None,\n        'out_account':op['account_id'] if op else ip['peer_account'],\n        'in_account':ip['account_id'] if ip else op['peer_account'],\n        'amount_minor':op['amount_minor'] if op else ip['amount_minor'],\n    })\nprint(pending)\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
