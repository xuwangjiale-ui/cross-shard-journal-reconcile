[?2004l[?2004h>             plen=raw_len ^ 0xA5A5A5A5
[?2004l[?2004h>         elif ver==1:
[?2004l[?2004h>             plen=raw_len
[?2004l[?2004h>         else:
[?2004l[?2004h>             print('unknown version at',hex(i),ver); pos=i+4; continue
[?2004l[?2004h>         end=i+24+plen
[?2004l[?2004h>         if end>len(data):
[?2004l[?2004h>             print('bad/truncated frame at',hex(i),'ver',ver,'flags',flags,'type',typ,'raw_len',raw_len,'plen',plen,'seq',seq,'need_end',hex(end))
[?2004l[?2004h>             pos=i+4; continue
[?2004l[?2004h>         frame=bytearray(data[i:end])
[?2004l[?2004h>         frame[20:24]=b'\0\0\0\0'
[?2004l[?2004h>         calc=zlib.crc32(frame)&0xffffffff
[?2004l[?2004h>         payload=data[i+24:end]
[?2004l[?2004h>         dec=None; err=None
[?2004l[?2004h>         if flags & 1:
[?2004l[?2004h>             try: dec=zlib.decompress(payload)
[?2004l[?2004h>             except Exception as e: err=repr(e)
[?2004l[?2004h>         else:
[?2004l[?2004h>             dec=payload
[?2004l[?2004h>         print(f'frame {frame_no}: off={i:#x} ver={ver} flags={flags:#x} type={typ} raw_len={raw_len} plen={plen} seq={seq} crc_stored={stored_crc:#010x} crc_calc={calc:#010x} crc_ok={stored_crc==calc} payload_len={len(payload)} dec_len={len(dec) if dec is not None else None} zerr={err}')
[?2004l[?2004h>         if dec is not None:
