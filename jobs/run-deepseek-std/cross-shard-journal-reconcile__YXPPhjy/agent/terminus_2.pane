[?2004l[?2004h>                 print('  JSON:',json.loads(dec))
[?2004l[?2004h>             except Exception as e:
[?2004l[?2004h>                 print('  DECODED RAW:',dec, 'jsonerr',repr(e))
[?2004l[?2004h>         else:
