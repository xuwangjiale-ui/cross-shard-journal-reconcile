[335.800586, "o", "accounts = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.80073, "o", "seen_idempotency = set()\r\n\u001b[?2004l\r\u001b[?2004h> held = defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.801041, "o", "summary = defaultdict(lambda: defaultdict(int))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def ny_day(ts):\r\n\u001b[?2004l\r"]
[335.801203, "o", "\u001b[?2004h>     return datetime.fromtimestamp(ts, tz=timezone.utc).astimezone(NY).strftime('%Y-%m-%d')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def add_balance_delta(account_id, delta, ts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.80129, "o", "    acct = accounts[account_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.801414, "o", "    acct['balance_minor'] += delta\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.801577, "o", "    summary[ny_day(ts)][acct['currency']] += delta\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def apply_balance_event(account_id, delta, ts, idem_key=None):\r\n\u001b[?2004l\r"]
[335.801673, "o", "\u001b[?2004h>     if idem_key is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.801772, "o", "        if idem_key in seen_idempotency:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.801906, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h>         seen_idempotency.add(idem_key)\r\n\u001b[?2004l\r\u001b[?2004h> "]
