[335.807391, "o", "\u001b[?2004h> "]
[335.807434, "o", "    pending.append({\r\n\u001b[?2004l\r"]
[335.807455, "o", "\u001b[?2004h> "]
[335.807581, "o", "        'transfer_id': tid,\r\n\u001b[?2004l\r\u001b[?2004h"]
[335.807667, "o", "> "]
