[335.80686, "o", "    pair = legs[tid]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.806919, "o", "    out_ev = pair.get('out')\r\n\u001b[?2004l\r\u001b[?2004h>     in_ev = pair.get('in')"]
[335.806941, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
