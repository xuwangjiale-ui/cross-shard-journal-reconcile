[335.805715, "o", "    if acct['status'] == 'open':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.805774, "o", "        open_accounts[account_id] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.805835, "o", "            'account_id': acct['account_id'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.805872, "o", "            'currency': acct['currency'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.805969, "o", "            'balance_minor': acct['balance_minor'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[335.806038, "o", "> "]
[335.806113, "o", "            'opened_at': acct['opened_at'],\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[335.806191, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.806273, "o", "summary_out = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.806313, "o", "for day in sorted(summary):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.806434, "o", "    summary_out[day] = {cur: summary[day][cur] for cur in sorted(summary[day])}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.806505, "o", "pending = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
