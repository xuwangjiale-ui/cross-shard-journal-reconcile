[335.802146, "o", ">     if acct['status'] == 'closed':"]
[335.802162, "o", "\r\n\u001b[?2004l\r"]
[335.802266, "o", "\u001b[?2004h"]
[335.802289, "o", ">         held[account_id].append((delta, ts))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.802322, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.802456, "o", "        add_balance_delta(account_id, delta, ts)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[335.802529, "o", "\u001b[?2004l\r\u001b[?2004h> for ev in events:\r\n\u001b[?2004l\r"]
[335.802553, "o", "\u001b[?2004h> "]
[335.802667, "o", "    typ = ev['type']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.802709, "o", "    p = ev['payload']\r\n\u001b[?2004l\r\u001b[?2004h>     ts = ev['ts']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.802784, "o", "    if typ == 1:  # open\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.802844, "o", "        accounts[p['account_id']] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.80292, "o", "            'account_id': p['account_id'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.803022, "o", "            'currency': p['currency'],\r\n\u001b[?2004l\r\u001b[?2004h>             'balance_minor': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.803089, "o", "            'opened_at': p['opened_at'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[335.803137, "o", "> "]
[335.803274, "o", "            'status': 'open',\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     elif typ == 2:  # credit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.803379, "o", "        apply_balance_event(p['account_id'], p['amount_minor'], ts, p.get('idempotency_key'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[335.803495, "o", ">     elif typ == 3:  # debit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.803605, "o", "        apply_balance_event(p['account_id'], -p['amount_minor'], ts, p.get('idempotency_key'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[335.80368, "o", "> "]
[335.803786, "o", "    elif typ == 4:  # xfer_out\r\n\u001b[?2004l\r\u001b[?2004h>         tid = p['transfer_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
