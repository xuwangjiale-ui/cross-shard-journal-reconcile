[335.804003, "o", "            apply_balance_event(p['account_id'], -p['amount_minor'], ts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.804158, "o", "    elif typ == 5:  # xfer_in\r\n\u001b[?2004l\r\u001b[?2004h>         tid = p['transfer_id']\r\n\u001b[?2004l\r\u001b[?2004h>         if tid in complete_transfers:\r\n\u001b[?2004l\r"]
