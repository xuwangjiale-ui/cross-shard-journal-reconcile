[335.807958, "o", "> "]
[335.808048, "o", "        'has_in': in_ev is not None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.808176, "o", "        'out_account': out_p['account_id'] if out_p else in_p['peer_account'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[335.808245, "o", "> "]
[335.808388, "o", "        'in_account': in_p['account_id'] if in_p else out_p['peer_account'],\r\n\u001b[?2004l\r"]
[335.80841, "o", "\u001b[?2004h"]
[335.808462, "o", "> "]
[335.808599, "o", "        'amount_minor': out_p['amount_minor'] if out_p else in_p['amount_minor'],\r\n\u001b[?2004l\r"]
[335.80868, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
