[335.796803, "o", "\u001b[?2004l\r\u001b[?2004h>     return events\r\n\u001b[?2004l\rr': out_p['amou\u001b[?2004h> "]
[335.796889, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.797598, "o", "events = parse_journals()\r\n\u001b[?2004l\rp else in\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Identify complete cross-shard transfers.\r\n\u001b[?2004l\r\u001b[?2004h> legs = defaultdict(dict)\r\n\u001b[?2004l\r\u001b[?2004h> for ev in events:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.797775, "o", "    if ev['type'] in (4, 5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.79791, "o", "        tid = ev['payload']['transfer_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.798308, "o", "        legs[tid]['out' if ev['type'] == 4 else 'in'] = ev\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.79842, "o", "complete_transfers = set()\r\n\u001b[?2004l\r"]
[335.798526, "o", "\u001b[?2004h> "]
[335.798758, "o", "for tid, pair in legs.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.7993, "o", "    if 'out' not in pair or 'in' not in pair:\r\n\u001b[?2004l\r\u001b[?2004h"]
[335.799389, "o", "> "]
[335.799487, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     out_p = pair['out']['payload']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.799618, "o", "    in_p = pair['in']['payload']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.799748, "o", "    if (out_p['amount_minor'] == in_p['amount_minor'] and\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.799901, "o", "        out_p['account_id'] == in_p['peer_account'] and\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.800052, "o", "        in_p['account_id'] == out_p['peer_account']):\r\n\u001b[?2004l\r\u001b[?2004h>         complete_transfers.add(tid)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.800189, "o", "# Production ordering: earliest (ts, shard_id, seq) wins.\r\n\u001b[?2004l\r\u001b[?2004h> for ev in events:\r\n"]
[335.800324, "o", "\u001b[?2004l\r\u001b[?2004h>     p = ev['payload']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[335.80043, "o", "    ev['ts'] = p.get('ts', p.get('opened_at'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
