[29.020638, "i", "python3 - <<'PY'\nimport struct, zlib, json, pathlib\n\nfor path in sorted(pathlib.Path('/app/data/journals').glob('shard-*.jnl')):\n    data = path.read_bytes()\n    print('='*20, path, len(data), '='*20)\n    pos = 0\n    frame_no = 0\n    while True:\n        idx = data.find(b'JNL1', pos)\n        if idx < 0:\n            break\n        if idx != pos:\n            print(f'  noise/scan skip {pos}->{idx}: {data[pos:idx]!r}')\n        if idx + 24 > len(data):\n            print(f'  truncated header at {idx}: {data[idx:]!r}')\n            break\n        magic, ver, flags, typ, reserved = data[idx:idx+4], data[idx+4], data[idx+5], data[idx+6], data[idx+7]\n        raw_len = struct.unpack_from('<I', data, idx+8)[0]\n        seq = struct.unpack_from('<Q', data, idx+12)[0]\n        crc_stored = struct.unpack_from('<I', data, idx+20)[0]\n        if ver == 2:\n            plen = raw_len ^ 0xA5A5A5A5\n        else:\n            plen = raw_len\n        frame_end = idx + 24 + plen\n        print(f'FRAME {frame_no} off={idx} ver={ver} flags=0x{f"]
[29.020889, "i", "lags:02x} type={typ} seq={seq} raw_len=0x{raw_len:08x} plen={plen} crc=0x{crc_stored:08x} end={frame_end}')\n        if plen > 10_000_000 or frame_end > len(data):\n            print('  invalid/truncated length; scanning forward')\n            pos = idx + 4\n            frame_no += 1\n            continue\n        frame = bytearray(data[idx:frame_end])\n        frame[20:24] = b'\\x00\\x00\\x00\\x00'\n        calc = zlib.crc32(frame) & 0xffffffff\n        payload = data[idx+24:frame_end]\n        print(f'  crc_ok={calc==crc_stored} calc=0x{calc:08x}')\n        if flags & 1:\n            try:\n                payload = zlib.decompress(payload)\n                print('  decompressed')\n            except Exception as e:\n                print('  zlib error', repr(e))\n        try:\n            obj = json.loads(payload)\n            print('  payload', json.dumps(obj, sort_keys=True))\n        except Exception as e:\n            print('  payload raw', payload[:500], 'json error', repr(e))\n        pos = frame_end\n        frame_no += 1\nPY\n"]
