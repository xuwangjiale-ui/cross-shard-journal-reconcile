[?2004hroot@a8973d2ded9a:/app# python3 - <<'PY'
[?2004l[?2004h> import struct, zlib, json, pathlib
[?2004l[?2004h> 
[?2004l[?2004h> for path in sorted(pathlib.Path('/app/data/journals').glob('shard-*.jnl')):
[?2004l[?2004h>     data = path.read_bytes()
[?2004l[?2004h>     print('='*20, path, len(data), '='*20)
[?2004l[?2004h>     pos = 0
[?2004l[?2004h>     frame_no = 0
[?2004l[?2004h>     while True:
[?2004l[?2004h>         idx = data.find(b'JNL1', pos)
[?2004l[?2004h>         if idx < 0:
[?2004l[?2004h>             break
[?2004l[?2004h>         if idx != pos:
[?2004l[?2004h>             print(f'  noise/scan skip {pos}->{idx}: {data[pos:idx]!r}')
[?2004l[?2004h>         if idx + 24 > len(data):
[?2004l[?2004h>             print(f'  truncated header at {idx}: {data[idx:]!r}')
[?2004l[?2004h>             break
[?2004l[?2004h>         magic, ver, flags, typ, reserved = data[idx:idx+4], data[idx+4], data[idx+5], data[idx+6], data[idx+7]
[?2004l[?2004h>         raw_len = struct.unpack_from('<I', data, idx+8)[0]
[?2004l[?2004h>         seq = struct.unpack_from('<Q', data, idx+12)[0]
[?2004l[?2004h>         crc_stored = struct.unpack_from('<I', data, idx+20)[0]
[?2004l[?2004h>         if ver == 2:
[?2004l[?2004h>             plen = raw_len ^ 0xA5A5A5A5
[?2004l[?2004h>         else:
[?2004l[?2004h>             plen = raw_len
[?2004l[?2004h>         frame_end = idx + 24 + plen
[?2004l[?2004h>         print(f'FRAME {frame_no} off={idx} ver={ver} flags=0x{flags:02x} type={typ} seq={seq} raw_len=0x{raw_len:08x} plen={plen} crc=0x{crc_stored:08x} end={frame_end}')
[?2004l[?2004h>         if plen > 10_000_000 or frame_end > len(data):
[?2004l[?2004h>             print('  invalid/truncated length; scanning forward')
[?2004l[?2004h>             pos = idx + 4
[?2004l[?2004h>             frame_no += 1
[?2004l[?2004h>             continue
[?2004l[?2004h>         frame = bytearray(data[idx:frame_end])
[?2004l[?2004h>         frame[20:24] = b'\x00\x00\x00\x00'
[?2004l[?2004h>         calc = zlib.crc32(frame) & 0xffffffff
[?2004l[?2004h>         payload = data[idx+24:frame_end]
[?2004l[?2004h>         print(f'  crc_ok={calc==crc_stored} calc=0x{calc:08x}')
[?2004l[?2004h>         if flags & 1:
[?2004l[?2004h>             try:
[?2004l[?2004h>                 payload = zlib.decompress(payload)
[?2004l[?2004h>                 print('  decompressed')
[?2004l[?2004h>             except Exception as e:
