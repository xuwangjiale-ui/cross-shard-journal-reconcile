[?2004l[?2004h>     con=sqlite3.connect(p)
[?2004l[?2004h>     cur=con.cursor()
[?2004l[?2004h>     print('tables', cur.execute("select name,sql from sqlite_master where type='table'").fetchall())
[?2004l[?2004h>     for (name,) in cur.execute("select name from sqlite_master where type='table'"):
[?2004l[?2004h>         print(name, cur.execute(f'select * from "{name}"').fetchall())
