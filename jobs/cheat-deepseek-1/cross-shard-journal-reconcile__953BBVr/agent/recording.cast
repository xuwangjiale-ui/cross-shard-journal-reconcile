[399.676727, "o", ">         }\r\n\u001b[?2004l\r"]
[399.67682, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[399.676877, "o", "> pending_out = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
