[399.671829, "o", "        add_summary(app_ts, acct['currency'], delta)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.671907, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> for e in all_events:\r\n\u001b[?2004l\r"]
[399.671978, "o", "\u001b[?2004h>     typ = e['type']\r\n\u001b[?2004l\r"]
[399.672059, "o", "\u001b[?2004h>     obj = e['obj']\r\n\u001b[?2004l\r"]
[399.672131, "o", "\u001b[?2004h>     if typ == 8:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.67219, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.672271, "o", "    if typ == 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.672341, "o", "        aid = obj['account_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.672409, "o", "        if aid not in accounts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.672487, "o", "            accounts[aid] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.672577, "o", "                'account_id': aid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.672637, "o", "                'currency': obj['currency'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.672704, "o", "                'balance_minor': 0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[399.672782, "o", "> "]
[399.672854, "o", "                'opened_at': obj['opened_at'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.6729, "o", "                'open': True,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.672967, "o", "                'held': [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.672994, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.673082, "o", "        else:\r\n\u001b[?2004l\r"]
[399.673167, "o", "\u001b[?2004h>             accounts[aid]['open'] = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.673246, "o", "    elif typ in (2,3):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.673313, "o", "        key = obj['idempotency_key']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.673371, "o", "        if key in seen_idem:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.673482, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         seen_idem.add(key)\r\n\u001b[?2004l\r\u001b[?2004h"]
[399.673578, "o", "> "]
[399.673769, "o", "        delta = obj['amount_minor'] if typ == 2 else -obj['amount_minor']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.67391, "o", "        apply_delta(obj['account_id'], delta, obj['ts'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.673985, "o", "    elif typ in (4,5):\r\n\u001b[?2004l\r\u001b[?2004h>         tid = obj['transfer_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.674073, "o", "        if tid not in complete_transfers:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.674252, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         delta = -obj['amount_minor'] if typ == 4 else obj['amount_minor']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.67454, "o", "        apply_delta(obj['account_id'], delta, obj['ts'])\r\n\u001b[?2004l\r\u001b[?2004h>     elif typ == 6:\r\n\u001b[?2004l\r\u001b[?2004h>         aid = obj['account_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[399.674665, "o", "        if aid in accounts:\r\n\u001b[?2004l\r\u001b[?2004h>             accounts[aid]['open'] = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[399.674755, "o", ">     elif typ == 7:\r\n"]
[399.674917, "o", "\u001b[?2004l\r\u001b[?2004h>         aid = obj['account_id']\r\n\u001b[?2004l\r"]
[399.675038, "o", "\u001b[?2004h>         if aid in accounts:\r\n\u001b[?2004l\r"]
[399.675193, "o", "\u001b[?2004h>             acct = accounts[aid]\r\n\u001b[?2004l\r\u001b[?2004h>             acct['open'] = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[399.675342, "o", "> "]
